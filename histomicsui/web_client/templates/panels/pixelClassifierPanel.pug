.panel.panel-default.h-pc-panel
  .panel-heading(style='cursor:pointer', data-toggle='collapse', data-target='#h-pc-body')
    span.panel-title
      | Pixel Classifier
      if session
        span.label.label-info.pull-right(style='margin-top:2px; font-size:11px; font-weight:normal') Configured
  #h-pc-body.panel-collapse.collapse.in
    .panel-body
      if loading
        p.text-muted
          i.icon-spin.icon-spin-animate
          |  Loading…

      else if !session
        p.text-muted No pixel classifier configured for this folder.
        button.btn.btn-primary.btn-sm.h-pc-setup-btn
          i.icon-cog
          |  Set Up Classifier

      else
        .h-pc-split-counts(style='margin-bottom:4px')
          span.label.label-primary= 'Train: ' + splitCounts.train
          = ' '
          span.label.label-warning= 'Test: ' + splitCounts.test
          if splitCounts.val > 0
            = ' '
            span.label.label-success= 'Val: ' + splitCounts.val
          = ' '
          span.label.label-default= 'Unassigned: ' + splitCounts.unassigned

        .h-pc-annotation-info(style='margin-bottom:8px')
          span.label.label-default(style='font-weight:normal')
            = 'Annotation: ' + (session.positive_annotation_name || '(not set)')
          if session.roi_annotation_name
            = ' '
            span.label.label-default(style='font-weight:normal')
              = 'ROI: ' + session.roi_annotation_name

        if splitCounts.train < 1
          .h-pc-train-warning.alert.alert-warning.small(style='padding:6px 10px;margin-bottom:8px')
            i.icon-attention
            |  Assign at least one slide to Train to enable training.
        else
          .h-pc-train-warning(style='display:none')

        if lastIt
          .h-pc-last-result(style='margin-bottom:8px')
            ul.list-unstyled.small(style='margin-bottom:0')
              li
                i.icon-ok.text-success
                = '  Last trained: Iteration ' + lastIt.num
                if lastIt.trained_at
                  = ' (' + lastIt.trained_at.slice(0, 10) + ')'
              if lastIt.split_counts
                - var sc = lastIt.split_counts
                li
                  i.icon-circle-empty.text-muted
                  = '  Train: ' + (sc.train || 0) + ' patches'
                  if sc.test
                    = ' · Test: ' + sc.test
                  if sc.val
                    = ' · Val: ' + sc.val
              if lastIt.metrics
                - var m = lastIt.metrics
                li
                  i.icon-chart-bar.text-muted
                  = '  Accuracy —'
                  if m.train_accuracy !== null && m.train_accuracy !== undefined
                    = ' Train: ' + (m.train_accuracy * 100).toFixed(1) + '%'
                  if m.test_accuracy !== null && m.test_accuracy !== undefined
                    = ' · Test: ' + (m.test_accuracy * 100).toFixed(1) + '%'
                  if m.val_accuracy !== null && m.val_accuracy !== undefined
                    = ' · Val: ' + (m.val_accuracy * 100).toFixed(1) + '%'

        .table-responsive(style='margin-bottom:8px')
          table.table.table-condensed.table-bordered.h-pc-table(style='font-size:12px;margin-bottom:0')
            thead
              tr
                th Slide
                th(style='text-align:center;border-left:2px solid #aaa') —
                th(style='text-align:center') Train
                th(style='text-align:center') Test
                th(style='text-align:center') Val
            tbody
              each item in items
                tr(class=item.split ? '' : 'text-muted')
                  td(style='max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap', title=item.name)= item.name
                  td(style='text-align:center;border-left:2px solid #aaa')
                    input.h-pc-split-radio(type='radio', name='pc_split_' + item._id, value='', data-item-id=item._id, checked=!item.split ? true : undefined)
                  td(style='text-align:center')
                    input.h-pc-split-radio(type='radio', name='pc_split_' + item._id, value='train', data-item-id=item._id, checked=item.split === 'train' ? true : undefined)
                  td(style='text-align:center')
                    input.h-pc-split-radio(type='radio', name='pc_split_' + item._id, value='test', data-item-id=item._id, checked=item.split === 'test' ? true : undefined)
                  td(style='text-align:center')
                    input.h-pc-split-radio(type='radio', name='pc_split_' + item._id, value='val', data-item-id=item._id, checked=item.split === 'val' ? true : undefined)

        .h-pc-actions
          button.btn.btn-default.btn-xs.h-pc-edit-btn
            i.icon-pencil
            |  Edit
          = ' '
          button.btn.btn-primary.btn-xs.h-pc-train-btn(disabled=!canTrain ? 'disabled' : undefined)
            i.icon-play
            |  Train
          = ' '
          button.btn.btn-default.btn-xs.h-pc-apply-btn(disabled=!session.current_model_item_id ? 'disabled' : undefined)
            i.icon-upload-cloud
            |  Apply
            span.h-pc-apply-count

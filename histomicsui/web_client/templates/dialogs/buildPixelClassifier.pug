.modal.fade(tabindex='-1', role='dialog')
  .modal-dialog(role='document')
    .modal-content
      .modal-header
        button.close(type='button', data-dismiss='modal', aria-label='Close')
          span(aria-hidden='true') &times;
        h4.modal-title
          | Train Pixel Classifier — Iteration #{iteration}

      .modal-body
        if session
          p.text-muted.small(style='margin-bottom:8px')
            | Experiment:
            = ' '
            strong= session.name || '(unnamed)'
            |  &middot; Annotation: #{session.positive_annotation_name || '(not set)'}
            |  &middot; #{session.model_type || 'trident_linear'}
            |  &middot; #{session.magnification || 20}× / #{session.patch_size || 512} px
          if session.roi_annotation_name
            p.text-muted.small(style='margin-bottom:8px')
              | ROI: #{session.roi_annotation_name}

        if splitCounts
          .h-pc-split-summary(style='margin-bottom:12px')
            span.label.label-primary= 'Train: ' + splitCounts.train + ' slide' + (splitCounts.train !== 1 ? 's' : '')
            if splitCounts.test > 0
              = ' '
              span.label.label-warning= 'Test: ' + splitCounts.test + ' slide' + (splitCounts.test !== 1 ? 's' : '')
            if splitCounts.val > 0
              = ' '
              span.label.label-success= 'Val: ' + splitCounts.val + ' slide' + (splitCounts.val !== 1 ? 's' : '')

        .form-group
          label(for='h-pc-job-dir') Output Directory
          input#h-pc-job-dir.form-control(
            type='text',
            value=jobDir || '',
            placeholder='/Export/Shared/DSA/pixel_classifier'
          )
          p.help-block.small Container-internal path for intermediate files.

        .alert.alert-danger.hidden.h-pc-build-error

      .modal-footer
        button.btn.btn-default(type='button', data-dismiss='modal') Cancel
        button.btn.btn-primary.h-pc-build-submit(type='button') Train

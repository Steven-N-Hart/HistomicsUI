.modal.fade(tabindex='-1', role='dialog')
  .modal-dialog(role='document')
    .modal-content
      .modal-header
        button.close(type='button', data-dismiss='modal', aria-label='Close')
          span(aria-hidden='true') &times;
        h4.modal-title Build Slide Classifier

      .modal-body
        if experiment
          p.text-muted.small(style='margin-bottom:8px')
            | Experiment:
            |
            strong= experiment.name || '(unnamed)'
            | &nbsp;&middot; Classes:
            |
            = (experiment.classes || []).join(', ')

        if splitCounts
          p.small(style='margin-bottom:12px')
            span.label.label-primary= 'Train: ' + splitCounts.train
            = ' '
            span.label.label-warning= 'Test: ' + splitCounts.test
            if splitCounts.val
              = ' '
              span.label.label-success= 'Val: ' + splitCounts.val

        .form-group
          label(for='h-sc-feature-kind') Feature Source
          select#h-sc-feature-kind.form-control(name='feature_kind')
            option(value='mean_pool_patch', selected) Mean-pool patch features (works with any TRIDENT run)
            option(value='slide') Slide-encoder features
          p.help-block.small Reads each item's <code>meta.trident.features_h5</code> generated by the TRIDENT Embeddings job.

        .form-group.h-sc-slide-encoder-group(style='display:none')
          label(for='h-sc-slide-encoder') Slide Encoder Name
          input#h-sc-slide-encoder.form-control(type='text', name='slide_encoder', placeholder='e.g. titan, threads, mean-conch_v15')
          p.help-block.small Looks for <code>slide_features_&lt;name&gt;/&lt;stem&gt;.h5</code> next to the patch features.

        .form-group
          label(for='h-sc-model-type') Model
          select#h-sc-model-type.form-control(name='model_type')
            option(value='logistic', selected) Logistic regression
            option(value='mlp') MLP (256-hidden)

        .form-group
          label(for='h-sc-task-type') Task Type
          select#h-sc-task-type.form-control(name='task_type')
            option(value='multilabel', selected) Multi-label (independent binary per class)
            option(value='multiclass') Multi-class (exactly one class per slide)

        .row
          .col-sm-6.form-group
            label(for='h-sc-c') Regularization (C)
            input#h-sc-c.form-control(type='number', name='regularization', value='1.0', step='0.1', min='0.01')
          .col-sm-6.form-group
            label(for='h-sc-max-iter') Max Iterations
            input#h-sc-max-iter.form-control(type='number', name='max_iter', value='1000', step='100', min='1')

        .form-group
          label(for='h-sc-job-dir') Output Directory
          input#h-sc-job-dir.form-control(type='text', name='job_dir', value=jobDir || '')
          p.help-block.small Container-internal path where <code>model.pkl</code>, <code>metrics.json</code>, and <code>predictions.csv</code> are written.

        .alert.alert-danger.hidden.h-sc-error

      .modal-footer
        button.btn.btn-default(type='button', data-dismiss='modal') Cancel
        button.btn.btn-primary.h-sc-submit(type='button') Train

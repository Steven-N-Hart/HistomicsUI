.modal.fade(tabindex='-1', role='dialog')
  .modal-dialog(role='document')
    .modal-content
      .modal-header
        button.close(type='button', data-dismiss='modal', aria-label='Close')
          span(aria-hidden='true') &times;
        h4.modal-title AI Experiment Setup
      .modal-body
        .form-group
          label(for='h-ai-exp-name') Experiment Name
          input#h-ai-exp-name.form-control(type='text', placeholder='e.g. Tumor Grading', value=name || '')

        .form-group
          label Target Annotations
          p.help-block.small Select one or more annotation layers to use as prediction targets.
          p.h-ai-scanning.text-muted(style='margin-bottom:4px')
            i.icon-spin.icon-spin-animate
            |  Scanning annotations across slides…
          .h-ai-target-list

        .form-group
          label Scope
          .radio
            label
              input#h-ai-scope-whole(type='radio', name='h-ai-scope', value='whole_slide')
              |  Whole slide &mdash; use TRIDENT tissue segmentation
          .radio
            label
              input#h-ai-scope-roi(type='radio', name='h-ai-scope', value='roi')
              |  ROI &mdash; use a drawn annotation as the region

        .form-group.h-ai-roi-group(style='display:none')
          label(for='h-ai-roi-annotation') ROI Annotation
          select#h-ai-roi-annotation.form-control
            option(value='') — select —
          p.help-block.small The annotation layer whose polygons define the region of interest.

        .g-validation-failed-message.hidden.text-danger
      .modal-footer
        button.btn.btn-default(type='button', data-dismiss='modal') Cancel
        button.btn.btn-primary.h-ai-save-btn(type='button') Save
